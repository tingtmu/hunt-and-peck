<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.console" Version="2.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeMethods\NativeMethods.csproj" />
    <ProjectReference Include="..\HuntAndPeck\HuntAndPeck.csproj" />
    <!-- Built before the tests, but only run, not referenced; copied next to the test dll below -->
    <ProjectReference Include="..\HuntAndPeck.UiaFixture\HuntAndPeck.UiaFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\HuntAndPeck\app.manifest" Link="app.manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The tests use UIA types too; generates this project's own copy of the interop assembly -->
  <Import Project="..\HuntAndPeck\UIAutomationInterop.targets" />

  <Target Name="CopyUiaFixture" AfterTargets="Build">
    <Copy SourceFiles="..\HuntAndPeck.UiaFixture\bin\$(Configuration)\HuntAndPeck.UiaFixture.exe" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
