<Window x:Class="HuntAndPeck.Views.OptionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HuntAndPeck.Views"
        Title="{Binding DisplayName}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=MainHotKeyBox}">
    <Window.Resources>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,12,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="12,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12" Width="440">
        <GroupBox Header="Hotkeys">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="_Hints for window:" Target="{Binding ElementName=MainHotKeyBox}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <views:HotKeyCaptureBox x:Name="MainHotKeyBox"
                                            DataContext="{Binding MainHotKey}"
                                            Text="{Binding DisplayText, Mode=OneWay}"
                                            CaptureCommand="{Binding CaptureCommand}"
                                            AutomationProperties.Name="Hotkey for hints in the foreground window"
                                            GotKeyboardFocus="HotKeyBox_GotKeyboardFocus"
                                            LostKeyboardFocus="HotKeyBox_LostKeyboardFocus" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding MainHotKey.Error}" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top"
                        Content="Reset" Command="{Binding MainHotKey.ResetCommand}"
                        AutomationProperties.Name="Reset window hotkey to default" />

                <Label Grid.Row="1" Grid.Column="0" Content="Hints for _taskbar:" Target="{Binding ElementName=TaskbarHotKeyBox}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <views:HotKeyCaptureBox x:Name="TaskbarHotKeyBox"
                                            DataContext="{Binding TaskbarHotKey}"
                                            Text="{Binding DisplayText, Mode=OneWay}"
                                            CaptureCommand="{Binding CaptureCommand}"
                                            AutomationProperties.Name="Hotkey for hints in the taskbar"
                                            GotKeyboardFocus="HotKeyBox_GotKeyboardFocus"
                                            LostKeyboardFocus="HotKeyBox_LostKeyboardFocus" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding TaskbarHotKey.Error}" />
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top"
                        Content="Reset" Command="{Binding TaskbarHotKey.ResetCommand}"
                        AutomationProperties.Name="Reset taskbar hotkey to default" />

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource HelpText}"
                           Text="Click a box, then press the new key combination (Ctrl, Alt or Win plus a key, or F1-F24)." />
            </Grid>
        </GroupBox>

        <GroupBox Header="Hint labels">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="_Letters:" Target="{Binding ElementName=AlphabetBox}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox x:Name="AlphabetBox" MaxLength="40" CharacterCasing="Upper"
                             Text="{Binding HintAlphabetText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource HelpText}" Text="{Binding HintAlphabetHelp}" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HintAlphabetError}" />
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="0" Content="_Font size:" Target="{Binding ElementName=FontSizeBox}" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <ComboBox x:Name="FontSizeBox" IsEditable="True" Width="80" HorizontalAlignment="Left"
                              ItemsSource="{Binding FontSizeChoices}"
                              Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource HelpText}" Text="{Binding FontSizeHelp}" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FontSizeError}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding SaveError}" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
