<Window x:Class="HuntAndPeck.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="hap" Height="0" Width="0"
        WindowStyle="None" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        Visibility="Hidden">
    <tb:TaskbarIcon x:Name="TrayIcon"
                    Visibility="Visible"
                    IconSource="/Resources/originalbird.ico"
                    ToolTipText="{Binding ToolTipText}"
                    MenuActivation="LeftOrRightClick">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem Header="Options" Command="{Binding ShowOptionsCommand}"></MenuItem>
                <!-- OneWay: the command applies the change, then the view model re-reads and pushes the actual state -->
                <MenuItem Header="Start with Windows"
                          IsCheckable="True"
                          IsChecked="{Binding StartWithWindows, Mode=OneWay}"
                          Command="{Binding ToggleStartWithWindowsCommand}"></MenuItem>
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}"></MenuItem>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
        
</Window>