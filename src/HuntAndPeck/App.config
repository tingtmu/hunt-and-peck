<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
    <runtime>
        <!-- WPF per-monitor DPI: rescale windows on WM_DPICHANGED. This is already the default when targeting
             .NET Framework 4.6.2+, stated explicitly so the app.manifest PerMonitorV2 setting is honoured. -->
        <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
    </runtime>
</configuration>